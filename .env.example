# PostgreSQL connection string (Kubero provides this)
DATABASE_URL=postgresql://user:password@localhost:5432/dostt_dashboard

# Set to "true" if your DB requires SSL (e.g. cloud-hosted)
DB_SSL=false

# Redash JSON endpoint (no API key in the URL — use REDASH_API_KEY below)
REDASH_API_URL=https://analytics.getlokalapp.com/api/queries/18014/results.json

# Redash API key (kept server-side only, never exposed to browser)
REDASH_API_KEY=ojCseQ9tdbPCYcNUtguqz7ue7gLp3ao53zwYto7z

# Your public app URL
NEXT_PUBLIC_BASE_URL=https://expert.dostt.app

# Google Sheets logging (optional) — paste your Apps Script Web App URL here
# The sheet must have columns: Timestamp | Mobile | Device | Browser | Today | Overall | History | IP
GOOGLE_SHEET_SCRIPT_URL=
